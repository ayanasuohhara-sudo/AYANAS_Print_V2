(function() {
'use strict';

const ORDER_APP_ID = 16;

kintone.events.on([
  'app.record.create.submit',
  'app.record.edit.submit'
], function(event) {

  const barcode = event.record.barcode_input.value;

  if (!barcode) {
    alert('管理番号を入力してください');
    return false;
  }

  return kintone.api(
    kintone.api.url('/k/v1/records.json', true),
    'GET',
    {
      app: ORDER_APP_ID,
      query: 'manage_no = "' + barcode + '"'
    }
  ).then(function(resp) {

    if (resp.records.length === 0) {
      alert('管理番号が見つかりません');
      return false;
    }

    const rec = resp.records[0];

    const exists =
      event.record.outsource_detail.value.some(function(row) {

        return (
          row.value.manage_no &&
          row.value.manage_no.value === rec.manage_no.value
        );

      });

    if (!exists) {

      event.record.outsource_detail.value.push({
        value: {

          manage_no: {
            type: 'SINGLE_LINE_TEXT',
            value: rec.manage_no.value
          },

          customer_code: {
            type: 'SINGLE_LINE_TEXT',
            value: rec.customer_code.value
          },

          client_name: {
            type: 'SINGLE_LINE_TEXT',
            value: rec.client_name.value
          },

          kimono_type: {
            type: 'SINGLE_LINE_TEXT',
            value: rec.kimono_type.value
          }

        }
      });

    }

    return kintone.api(
      kintone.api.url('/k/v1/record.json', true),
      'PUT',
      {
        app: ORDER_APP_ID,
        id: rec.$id.value,
        record: {
          process_status: {
            value: '外注中'
          },
          location_status: {
            value: '外注先'
          }
        }
      }
    ).then(function() {

      return event;

    });

  }).catch(function(err) {

    console.error(err);
    alert(err.message);

    return false;

  });

});

})();

